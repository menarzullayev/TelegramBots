# ─── Telegram ───────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
WEBHOOK_SECRET=your_random_webhook_secret
WEBHOOK_URL=https://yourdomain.com/webhook

# ─── AI Providers ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tezmath:password@postgres:5432/tezmath
DATABASE_URL_SYNC=postgresql://tezmath:password@postgres:5432/tezmath

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://:password@redis:6379/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ─── RabbitMQ ───────────────────────────────────────────
RABBITMQ_URL=amqp://tezmath:password@rabbitmq:5672/
RABBITMQ_SOLVER_QUEUE=solver_tasks
RABBITMQ_RENDER_QUEUE=render_tasks
RABBITMQ_NOTIFY_QUEUE=notify_tasks

# ─── Storage (S3/MinIO) ─────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tezmath-renders
S3_PUBLIC_URL=https://cdn.yourdomain.com

# ─── Payment ────────────────────────────────────────────
PAYME_MERCHANT_ID=your_merchant_id
PAYME_SECRET_KEY=your_secret_key
PAYME_TEST_MODE=true

CLICK_SERVICE_ID=your_service_id
CLICK_MERCHANT_ID=your_merchant_id
CLICK_SECRET_KEY=your_secret_key

# ─── Admin ──────────────────────────────────────────────
ADMIN_IDS=1396503733
ADMIN_JWT_SECRET=your_admin_jwt_secret
ADMIN_JWT_EXPIRE_HOURS=24

# ─── App ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=https://...@sentry.io/...

# ─── Limits ─────────────────────────────────────────────
FREE_DAILY_LIMIT=5
PREMIUM_DAILY_LIMIT=999999
MAX_IMAGE_SIZE_MB=10
MAX_QUEUE_SIZE=1000
